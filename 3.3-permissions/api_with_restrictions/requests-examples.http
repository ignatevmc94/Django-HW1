# примеры API-запросов

@baseUrl = http://127.0.0.1:8000/
@token1 = 5fbf19403f468bec57b41f84748234e5529f3c28
@token2 = 98c4b15ca61a819720f95cf1a25d69a7b5e52d62

# получение объявлений
GET {{baseUrl}}/advertisements/
Content-Type: application/json
Authorization: Token {{token1}}
###

# создание объявления
POST {{baseUrl}}/advertisements/
Content-Type: application/json
Authorization: Token {{token1}}

{
  "title": "Сосну",
  "description": "Дорого"
}

###

# попытка поменять объявление
PATCH {{baseUrl}}/advertisements/3/
Content-Type: application/json
Authorization: Token {{token1}}

{
  "description": "Супер дешево!"
}
###

DELETE {{baseUrl}}/advertisements/2/
Content-Type: application/json
Authorization: Token {{token1}}

###

# фильтрация по создателю
GET {{baseUrl}}/advertisements/?status=CLOSED
Content-Type: application/json

###

# фильтрация по дате
GET {{baseUrl}}/advertisements/?created_at_before=2020-10-01
Content-Type: application/json
